# ===== 数据库（P1 起使用）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=live
DB_USER=root
DB_PASSWORD=123456

# ===== Redis（P2 起使用）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== MinIO（P4 起使用）=====
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=live

# ===== JWT（P2 起使用）=====
# 生产环境必须覆盖，长度 >= 32 字节
JWT_SECRET=live-dev-only-secret-key-change-me-in-production-2026

# ===== 媒体服务器 =====
MEDIA_RTMP_HOST=localhost
MEDIA_RTMP_PORT=1935
MEDIA_HLS_BASE=http://localhost:8888
MEDIA_WEBRTC_BASE=http://localhost:8889
MEDIA_API_BASE=http://127.0.0.1:9997

# ===== 服务端口 =====
SERVER_PORT=8080
